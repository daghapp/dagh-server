# Phase 3.3 — Environment template documenting all required env vars.
# Copy this file to .env and fill in the values.

# Server
PORT=5000
API_URL=http://localhost:5000

# Call / WebRTC media service (returned as serviceUrl by POST /calls/token and socket call events)
# LiveKit is preferred when configured; otherwise CALL_SERVICE_URL, then API_URL.
# Get these from a LiveKit Cloud project (Settings -> Keys) or your self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CALL_SERVICE_URL=http://localhost:5000

# Database (Prisma 7 reads this via prisma.config.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/dagh

# Database pool tuning (optional, defaults shown)
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Redis (REQUIRED for horizontal scaling across multiple instances)
# Enables the shared Socket.IO adapter, cross-instance presence, a shared
# rate-limit store, and distributed locks so cron jobs run on only one replica.
# Leave unset to run in single-instance mode (in-memory presence + per-instance
# rate limiting + unlocked cron jobs).
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_SECRET=
SESSIONSECRET=

# Hubtel (required)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_NUMBER=
HUBTEL_BASE_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend)
RESEND_API_KEY=

# CORS (comma-separated origins, required)
ALLOWED_ORIGINS=http://localhost:3000

# OAuth
CLIENTID=
CLIENTSECRETE=
REDIRECTURI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_CALLBACK_URL=

# Currency
USD_TO_GHS_RATE=15.5

# Visa pricing (optional, defaults shown)
VISA_STANDARD_FEE_GHS=464
VISA_EXPEDITED_FEE_GHS=1450
VISA_STATUTORY_FEE_USD=200

# Itinerary pricing (optional, defaults shown)
ITINERARY_SHORT_FEE_GHS=350
ITINERARY_LONG_FEE_GHS=500
