# Phase 3.3 — Environment template documenting all required env vars.
# Copy this file to .env and fill in the values.

# Server
PORT=5000
API_URL=http://localhost:5000

# Call / WebRTC media service (returned as serviceUrl by POST /calls/token and socket call events)
# LiveKit is preferred when configured; otherwise CALL_SERVICE_URL, then API_URL.
# Get these from a LiveKit Cloud project (Settings -> Keys) or your self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CALL_SERVICE_URL=http://localhost:5000

# Firebase Cloud Messaging — direct FCM via firebase-admin (Android native calls
# and Android message alerts). Must be a service account on the same project the
# mobile app uses. Never ship this key in the app.
# Expo Push Service FCM credentials in EAS are a separate sending path.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Apple Push Notification service (required for iOS VoIP call pushes so a
# terminated app can still ring via PushKit). Generate an APNs Auth Key (.p8)
# in Apple Developer -> Certificates, Identifiers & Profiles -> Keys.
# APPLE_BUNDLE_ID is the app's bundle identifier; the PushKit topic becomes <bundle-id>.voip.
# APPLE_APNS_PRODUCTION=true targets production; omit/false targets the sandbox.
APPLE_APNS_KEY_ID=
APPLE_APNS_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_APNS_P8_KEY=
# Alternative to APPLE_APNS_P8_KEY — path to the .p8 file on disk.
# APPLE_APNS_KEY_PATH=
# APPLE_APNS_PRODUCTION=true

# Database (Prisma 7 reads this via prisma.config.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/dagh

# Database pool tuning (optional, defaults shown)
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Redis (REQUIRED for horizontal scaling across multiple instances)
# Enables the shared Socket.IO adapter, cross-instance presence, a shared
# rate-limit store, and distributed locks so cron jobs run on only one replica.
# Leave unset to run in single-instance mode (in-memory presence + per-instance
# rate limiting + unlocked cron jobs).
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# REQUIRED in any non-test environment (server throws at boot without it).
# Signs the short-lived pre-2FA admin MFA token; must be distinct from
# JWT_ACCESS_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_MFA_SECRET=
JWT_SECRET=
SESSIONSECRET=

# Hubtel
# Credentials may instead be managed at runtime from
# Admin > Settings > Payment Gateway, which encrypts them at rest. When a saved
# gateway configuration exists it takes precedence and these values act as the
# fallback for deployments that have never used the settings screen.
# HUBTEL_MERCHANT_NUMBER and HUBTEL_BASE_URL are deployment topology, not
# credentials, so they remain environment-only.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_NUMBER=
HUBTEL_BASE_URL=
# Optional. Overrides the transaction-status host used for payment verification
# and for the settings screen's connection probe. Defaults to Hubtel's public
# host; point it at a sandbox host if you use one.
HUBTEL_STATUS_API_BASE=

# Encrypts payment gateway credentials at rest (AES-256-GCM).
# REQUIRED in any non-test environment. Exactly 32 bytes, supplied as 64 hex
# characters or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value makes previously stored secrets undecryptable — rotate
# credentials through the settings screen after changing it.
#
# Also seals YouTube channel-grant refresh tokens, under a separate AAD context
# so a ciphertext cannot be moved between the two. Reusing one key keeps the key
# count at one and rules out a second secret being absent at boot. The cost is
# coupling: rotating this key also invalidates stored refresh tokens, which then
# read as "no usable credential" — affected grants keep working but stop being
# re-verifiable until each user re-runs the OAuth flow. To size the damage after
# a rotation, GET /community/admin/youtube-grants and read
# meta.summary.unverifiable: any row with tokenEncrypted=true AND
# unverifiable=true is sealed-but-unreadable. Also re-run
# POST /community/admin/youtube-grants/re-encrypt (no-op if nothing is
# plaintext).
# Also seals the Sign in with Apple refresh token kept for revocation on account
# deletion. If unset, Apple login still works but the token is not retained, so
# deletion cannot revoke the Apple grant.
PAYMENT_GATEWAY_ENCRYPTION_KEY=

# Payments — enabled by default. Set PAYMENTS_ENABLED=false to disable
# payment initialization (Hubtel checkout / MOMO). While disabled, all payment
# initiation endpoints return 503; callbacks and status verification for
# already-initiated payments keep working.
PAYMENTS_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Places API — external accommodation fallback (§1) plus the
# scripts/fetch-place-photos.ts site-photo enrichment. When set, the itinerary
# engine and /providers/nearby-hotels fall back to Places Nearby Search for
# lodging around a tour site when verified supply is insufficient. Leave blank
# to disable the external tier (verified supply only).
#
# Must be a SERVER key: enable Places API (New) and set Application restrictions
# to None (or the server's static egress IP). An Android-app-restricted key
# fails server-side calls with API_KEY_ANDROID_APP_BLOCKED.
GOOGLE_PLACES_API_KEY=

# YouTube Data API — powers the admin "sync channel videos" endpoint that
# auto-populates the community video feed from the channel's latest uploads.
# Create an API key: Google Cloud Console -> APIs & Services -> Credentials
# (YouTube Data API v3 must be enabled for the project).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Optional: resolve the channel by handle instead of an explicit ID.
# For https://www.youtube.com/@diasporaaffairsgh use @diasporaaffairsgh.
YOUTUBE_CHANNEL_HANDLE=@diasporaaffairsgh
# Cooldown (ms) between admin channel-sync runs to protect API quota. Default 1h.
# The cooldown is Redis-backed and is checked after the channel is resolved but
# BEFORE the uploads are fetched, so a sync inside the window costs no quota at
# all. With no REDIS_URL there is no cooldown and every call reaches YouTube.
YOUTUBE_SYNC_COOLDOWN_MS=3600000

# YouTube subscription verification — the decision that unlocks full-length videos.
#
# One decision, not one per video. A confirmed subscription to the channel opens
# the WHOLE feed; a per-video unlock is analytics about which card someone
# converted on and never opens anything by itself. Every community endpoint
# resolves this same way, so two endpoints cannot disagree about one user.
#
# Flow: GET /community/videos/:videoId/subscribe-intent ->
# GET /community/youtube/start/:videoId -> Google consent ->
# GET /community/youtube/callback -> the channel is checked against
# subscriptions.list and the result is stored with a short lease.
#
# REQUIRED IN PRODUCTION. The server FAILS CLOSED: with these unset every check
# resolves to NOT_CONNECTED / no access, so the feed stays locked and the app
# shows "verification unavailable". It will never grant on a client claim. The
# cost of misconfiguration is a locked product, not an open one — the server
# also logs a loud banner at boot when they are missing in production.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://dagh-server-fo64.onrender.com/community/youtube/callback
# App deep link the browser is redirected to after verification. Default
# daghapp://youtube/verify. Must be parseable by `new URL()`; if it is not, the
# browser gets a plain HTML page stating the real outcome instead of the deep
# link.
#
# The redirect carries accessVersion (and, at sign-in, hasChannelAccess) so the
# app can order it against later responses and draw the right state immediately.
# Those params are a HINT to avoid a wrong first frame — the API remains
# authoritative. A client must never derive access from this URL alone.
YOUTUBE_VERIFY_RETURN_URL=daghapp://youtube/verify
# How long (ms) a confirmed subscription is trusted before the next read
# re-checks Google.
#
# This is the whole staleness policy, and it is deliberately short. YouTube
# publishes no unsubscribe event, so a longer lease is a longer window in which
# someone who cancelled keeps watching. The trade-off is quota: a re-check costs
# one `subscriptions.list` unit, and only users who actually read the community
# spend any.
#
# Raise it if you are quota-bound on a large subscriber base. Lower it if you
# care more about catching cancellations than quota. Default 60s. Clamped to
# [5s, 1h]. An invalid value falls back to the default rather than to "no
# lease", because a zero lease would turn every read into an API call.
COMMUNITY_ACCESS_LEASE_SECONDS=60
# How long (ms) a failed check is remembered before trying Google again, so a
# user with no Google connection does not spend a token request on every read.
# Failures are NEVER extended into a grant: this caches the inability to check,
# not a positive verdict. Default 60s. Clamped to [5s, 1h].
COMMUNITY_ACTIVE_RECHECK_SECONDS=60
# Wall-clock budget (ms) for one nightly re-verification pass. The pass drains
# the due queue in batches until it is empty or this budget runs out, so
# throughput tracks the subscriber base rather than being capped per run.
# Default 10 min. Each grant costs a token refresh plus 1 quota unit and runs
# sequentially, so raise this when the sweep logs "Ran out of budget" — that
# warning means revocation latency for inactive users has outgrown the window.
# Clamped to [1 min, 13 min] so a pass cannot outlive the job lock.
COMMUNITY_REVERIFY_BUDGET_MS=600000
# How many due grants one nightly sweep batch claims. Default 200. Clamped to
# [1, 2000]. Raise only if the pass is finishing well inside its budget; a batch
# larger than the budget can process is pure lock contention.
COMMUNITY_ACTIVE_RECHECK_BATCH=200

# Sentry (error & performance monitoring). Leave SENTRY_DSN unset to disable.
# DSN: Settings -> Projects -> <project> -> Client Keys (DSN).
SENTRY_DSN=
# Release tag; MUST match the --release used when uploading source maps so prod
# stack traces map back to TS lines. Use your git commit SHA or app version.
SENTRY_RELEASE=
# Fraction of transactions to sample for performance (0-1). Default: 0.1 prod / 1.0 dev.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time values for source-map upload (see package.json "sentry:sourcemaps").
# These are only used when running the upload step (CI or Docker build).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Email (Resend)
# EMAIL_FROM is optional and defaults to the address below. Verify the
# diasporaadvocacygh.org domain in Resend (DNS) before sending in production.
RESEND_API_KEY=
EMAIL_FROM="Diaspora Affairs Ghana <noreply@diasporaadvocacygh.org>"

# CORS (comma-separated origins, required)
ALLOWED_ORIGINS=http://localhost:3000

# OAuth (Google / Facebook / Apple Sign In)
# Callback URLs MUST match the current production domain. Earlier deploys saw
# Facebook pointing at an old host (dagh-server-3.onrender.com); use
# https://dagh-server-fo64.onrender.com/auth/<provider>/callback on Render.
# Also add the same URL in the provider consoles:
#   Google:  OAuth client -> Authorized redirect URIs
#   Facebook: App -> Facebook Login -> Valid OAuth Redirect URIs
#   Apple:   Services ID -> Sign in with Apple -> (re-enter before first use)
# Google (passport consumer key/secret from a Google Cloud OAuth 2.0 Client)
CLIENTID=
CLIENTSECRETE=
REDIRECTURI=https://dagh-server-fo64.onrender.com/auth/google/callback
# Facebook (app id/secret from Facebook Developer -> App -> App secret)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://dagh-server-fo64.onrender.com/auth/facebook/callback
# Apple Sign In. Until these are ALL set, /auth/apple returns 503 (by design).
# Create a Sign in with Apple key (.p8) in Apple Developer -> Keys. Supply the
# key EITHER inline (APPLE_PRIVATE_KEY, with literal \n escapes for newlines)
# OR as a mounted file (APPLE_PRIVATE_KEY_PATH). Inline wins when both are set,
# and a path that does not exist is treated as unconfigured. APPLE_CALLBACK_URL
# must be re-entered in the Apple console exactly once (edit -> next -> save).
APPLE_CLIENT_ID=com.example.service.bundle
APPLE_TEAM_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY_PATH=/etc/secrets/AuthKey.p8
APPLE_CALLBACK_URL=https://dagh-server-fo64.onrender.com/auth/apple/callback
# App Store 3.1.1: paid digital memberships are blocked for clients declaring
# platform=ios while this is false. Set true only with Apple's External
# Purchase Link entitlement. Web/Android are never affected.
IOS_EXTERNAL_DIGITAL_PURCHASES=false

# Currency
USD_TO_GHS_RATE=15.5

# Visa pricing (optional, defaults shown)
VISA_STANDARD_FEE_GHS=464
VISA_EXPEDITED_FEE_GHS=1450
VISA_STATUTORY_FEE_USD=200

# Itinerary pricing (optional, defaults shown)
ITINERARY_SHORT_FEE_GHS=350
ITINERARY_LONG_FEE_GHS=500

# Shareable preview links
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.simplymark.diasporansync
APP_STORE_URL=
APP_DEEP_LINK_SCHEME=diasporansync

# OpenSearch (optional). Dating name search uses OpenSearch when
# OPENSEARCH_NODE is set and falls back to Postgres otherwise. Run
# `npm run search:reindex` once after enabling to populate the index.
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=dagh-dating-profiles
OPENSEARCH_TIMEOUT_MS=3000
