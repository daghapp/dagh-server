}

model LedgerAccount {
  id           String              @id @default(uuid())
  name         String              @unique // e.g. "Account_DAGh_Revenue", "Account_GIS_Statutory_Reserve"
  currency     String // GHS or USD
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions LedgerTransaction[]
}

model LedgerTransaction {
  id          String        @id @default(uuid())
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String
  type        String // CREDIT or DEBIT
  description String?
  createdAt   DateTime      @default(now())
}

// ─────────────────────────────────────────
// ADMIN ACTIVITY LOG — audit trail for admin console actions
// (approve/reject/retry/status changes). Unlike the provider-scoped
// `AuditLog`, this is keyed to any domain entity via entityType + entityId.
// ─────────────────────────────────────────
model AdminActivityLog {
  id         String   @id @default(uuid())
  actorId    String
  entityType String // e.g. "VISA_REQUEST", "PAYMENT", "TOUR", "USER", "REPORT"
  entityId   String?
  action     String // e.g. "APPROVED", "REJECTED", "NOTE_ADDED", "STATUS_CHANGED"
  note       String?
  /// Structured, non-secret before/after context for the change (e.g.
  /// `{ "environment": { "from": "TEST", "to": "LIVE" } }`) plus the acting
  /// request's correlation id. Never store credentials here.
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// ─────────────────────────────────────────
// ADMIN PROFILE — department + role for admin console accounts.
// One per admin `User`; created on admin registration (or seed).
// ─────────────────────────────────────────
model AdminProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  department        AdminDepartment
  role              AdminRole
  mfaEnabled        Boolean         @default(false)
  mfaMethod         String? // e.g. "TOTP", "SMS"
  mfaSecret         String? // encrypted
  lastMfaAt         DateTime?
  backupCodes       String[] // hashed backup codes
  failedMfaAttempts Int             @default(0)
  lockedUntil       DateTime?
  createdBy         String? // userId of the account that registered this admin (null for self-registration/seed)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

enum AdminDepartment {
  EXECUTIVE_MANAGEMENT
  OPERATIONS_AND_MEMBERSHIP
  FINANCE_AND_COMPLIANCE
  TECHNICAL_SUPPORT
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  SUPPORT
}

// ─────────────────────────────────────────
// STATIC LOOKUP TABLE — seeded with real Ghana locations
// ─────────────────────────────────────────
model TourSite {
  id          String       @id @default(uuid())
  name        String       @unique
   region      String
   latitude    Float
   longitude   Float
   description String
   // Long-form historical background for the destination detail page.
   history     String?
   imageUrl    String?
   // Attribution shown alongside the hero/site photo.
   imageCredit String?
   category    SiteCategory
   // Multi-tag album keys (§5): supplementary tags beyond the primary `category`,
   // e.g. ["Adventure", "Historical"]. Album endpoints match either source.
   categories         String[]           @default([])
   // Accessibility tier used by the mobility engine (§2). Default mirrors the
   // original column default so pre-existing rows stay valid.
   transit_profile TransitProfile @default(RURAL) // Urban Center | Peri_Urban | Rural
   createdAt   DateTime     @default(now())
 
   requestSites      TourRequestSite[]
   itineraryDaySites ItineraryDaySite[]
   photos            SitePhoto[]
 
   @@map("tour_sites")
}

enum TransitProfile {
  URBAN_CENTER
  PERI_URBAN
  RURAL
}

// ─────────────────────────────────────────
// USER-SUBMITTED TOUR SITES — pending approval workflow
// Users submit new tour site forms written to this staging collection.
// Admins review and either approve (migrate to main tour_sites) or reject.
// ─────────────────────────────────────────
model PendingSite {
  id                String       @id @default(uuid())
  name              String
  region            String
  latitude          Float
  longitude         Float
  description       String?
  // Long-form historical background carried through to the production site.
  history           String?
  category          String // free-text category/tag
  imageUrl          String?
  imageUrl2         String?
  imageUrl3         String?
  imageUrl4         String?
  // Attribution for the submitted photo, carried through on approval.
  imageCredit       String?
  status            String     @default("pending") // pending, approved, rejected
  submittedBy       String // userId
  rejectReason      String?
  // Audit trail for moderation decisions (mirrors SitePhoto).
  moderatedBy       String? // admin userId
  moderatedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("pending_sites")
}

// ─────────────────────────────────────────
// COMMUNITY PHOTO UPLOADS (§4) — moderated gallery enrichment for tour sites.
// Uploads land here as PENDING; only APPROVED rows appear in the public gallery.
// ─────────────────────────────────────────
model SitePhoto {
  id           String      @id @default(uuid())
  tourSiteId   String
  uploaderId   String? // userId (null for legacy/admin uploads)
  caption      String? // user's experience/story (text-only posts allowed)
  url          String? // null for text-only experience posts
  publicId     String? // Cloudinary public id (used for deletion/moderation)
  thumbUrl     String? // Optimized WebP thumbnail for fast mobile rendering
  width        Int?
  height       Int?
  sizeBytes    Int?
  status       PhotoStatus @default(PENDING)
  rejectReason String?
  moderatedBy  String? // admin userId
  moderatedAt  DateTime?
  createdAt    DateTime    @default(now())

  tourSite TourSite @relation(fields: [tourSiteId], references: [id], onDelete: Cascade)

  @@index([tourSiteId, status])
  @@index([status, createdAt])
  @@map("site_photos")
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// PUBLIC TRANSPORT CATALOG (§2) — intercity buses (STC/VIP), trotro corridors
// and air ports used by the mobility engine when a tour site sits outside
// ride-hailing coverage. Coordinates describe the boarding point.
// ─────────────────────────────────────────
model PublicTransportService {
  id               String              @id @default(uuid())
  mode             PublicTransportMode
  operator         String // "STC", "VIP", "Metro Mass", "CTC", "Neoplan", "Ghana Airways"…
  originCity       String
  originStation    String? // primary station of origin, e.g. "Circle (Accra)"
  originLat        Float?
  originLng        Float?
  destinationCity  String?
  destinationRegion String?
  destinationLat   Float?
  destinationLng   Float?
  notes            String? // boarding route, drop-off junctions, frequency hints
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())

  @@unique([mode, operator, originCity, destinationCity])
  @@index([mode, destinationRegion])
  @@map("public_transport_services")
}

enum PublicTransportMode {
  INTERCITY_BUS // STC, VIP, Metro Mass…
  TROTRO // local minibus corridors
  DOMESTIC_AIR // domestic airports/airstrips
}

// ─────────────────────────────────────────
// TOUR REQUEST — submitted by user from frontend
// ─────────────────────────────────────────
enum Ethnicity {
  African
  Asian
  Black_African_American
  Caribbean
  Caucassian_White
  Hispanic_Latino
  Middle_Eastern
  Mixed
  Native_American_Indigenous
  Pacific_Islander
  Other
}

model TourRequest {
  id                 String   @id @default(uuid())
  userId             String
  tourType           TourType
  durationDays       Int // touring days only (excl. prep + departure)
  relocationInterest Boolean  @default(false) // saved, not acted on yet

  // Dynamic loop-routing hub chosen by the user (e.g. "Central" for Cape Coast).
  // NULL means the engine infers the hub from the selected sites.
  startRegion         String?
  // Explicit opt-in to more than two Greater Accra nights. The engine otherwise
  // confines Accra to the arrival/departure gateways to cut urban lodging cost.
  allowAccraOvernight Boolean @default(false)

  status RequestStatus @default(PENDING)

  apartmentType        ApartmentType?
  transportType        TransportType?
  companionInterest    Boolean        @default(false)
  // Tour-to-dating integration: user asked for casual-dating recommendations
  // during this trip. Gated behind full KYC verification.
  casualDatingInterest Boolean        @default(false)
  ethnicity            Ethnicity?

  paymentId     String?       @unique
  paymentStatus PaymentStatus @default(INITIALIZED)
  // True when the itinerary fee was waived (payments disabled or price 0).
  // Waived itineraries keep paymentId NULL so the unique column never collides.
  feeWaived     Boolean       @default(false)

  createdAt DateTime @default(now())

  selectedSites    TourRequestSite[]
  itinerary        Itinerary?
  datingSelections TourRequestDatingSelection[]
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentStatus])
  @@map("tour_requests")
}

// ─────────────────────────────────────────
// JUNCTION — which sites the user selected
// ─────────────────────────────────────────
model TourRequestSite {
  id            String @id @default(uuid())
  tourRequestId String
  tourSiteId    String

  tourRequest TourRequest @relation(fields: [tourRequestId], references: [id], onDelete: Cascade)
  tourSite    TourSite    @relation(fields: [tourSiteId], references: [id])

  @@unique([tourRequestId, tourSiteId])
  @@map("tour_request_sites")
}

// ─────────────────────────────────────────
// ITINERARY — generated after validation
// ─────────────────────────────────────────
model Itinerary {
  id               String   @id @default(uuid())
  tourRequestId    String   @unique
  isFeasible       Boolean
  feasibilityError String? // populated if validation fails
  totalDays        Int // durationDays + 2 (prep + departure)
  // Ordered region cascade the loop actually traverses, e.g.
  // ["Central", "Ashanti", "Volta", "Greater Accra"]. Regions never repeat.
  routeRegions     String[] @default([])
  // Nights attributed to Greater Accra, surfaced for the cost limiter.
  accraNights      Int      @default(0)
  // Non-fatal advisories (e.g. Accra night-cap breach) rendered with the plan.
  warnings         String[] @default([])
  createdAt        DateTime @default(now())

  tourRequest TourRequest    @relation(fields: [tourRequestId], references: [id], onDelete: Cascade)
  days        ItineraryDay[]

  @@map("itineraries")
}

// ─────────────────────────────────────────
// ITINERARY DAY — one row per day of the trip
// ─────────────────────────────────────────
model ItineraryDay {
  id                 String  @id @default(uuid())
  itineraryId        String
  dayNumber          Int // 1-based
  dayType            DayType
  relocationRequired Boolean @default(false) // saved, not acted on yet
  suggestedHotel     String? // saved, not acted on yet
  // Descriptive day label, e.g. "Canopy Walk & Coastal Heritage (Central Region)".
  title              String?
  // Primary region the day is anchored to — drives day naming + local sourcing.
  region             String?
  // Traveller's confirmed car rental for this day. NULL means the day still
  // serves the recommended localTransport. Restricted to verified car-rental
  // providers at the service layer.
  transportProviderId String?

  itinerary       Itinerary         @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  transportProvider Provider?       @relation(fields: [transportProviderId], references: [provider_id], onDelete: SetNull)
  sites           ItineraryDaySite[]

  @@unique([itineraryId, dayNumber])
  @@map("itinerary_days")
}

// ─────────────────────────────────────────
// ITINERARY DAY SITES — sites assigned to each touring day
// ─────────────────────────────────────────
model ItineraryDaySite {
  id             String @id @default(uuid())
  itineraryDayId String
  tourSiteId     String
  visitOrder     Int // 1, 2, or 3 — order within the day

  itineraryDay ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  tourSite     TourSite     @relation(fields: [tourSiteId], references: [id])

  @@unique([itineraryDayId, visitOrder])
  @@unique([itineraryDayId, tourSiteId])
  @@map("itinerary_day_sites")
}

