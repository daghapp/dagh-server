generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  authProvider AuthProvider
  // Optional user preference used for itinerary personalization
  ethnicity    Ethnicity?

  email               String                  @unique
  passwordHash        String?
  passwordLastChanged DateTime?
  accountStatus       AccountStatus           @default(PENDING_VERIFICATION)
  accountType         AccountType             @default(USER)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @default(now())
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  fullName            String
  dateOfBirth         DateTime?
  gender              String?
  phoneNumber         String?                 @unique
  deviceTokens        DeviceToken[]
  payments            Payment[]
  profile             UserProfile?
  subscription        UserSubscription?
  verification        UserVerification?
  tourBookings        tour_bookings[]
  sentMessages        Message[]               @relation("SentMessages")
  receivedMessages    Message[]               @relation("ReceivedMessages")
  userTourItineraries user_tour_itineraries[]
  visaRequests        VisaOnArrivalRequest[]

  tourRequests TourRequest[]

  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Public profile fields
  profileUrl  String?
  phoneNumber String?

  // Bio profile image
  bio_profile_image_url         String?
  bio_profile_image_uploaded_at DateTime?

  // Bio document uploads
  bio_document_urls        String[]
  bio_document_type        BioDocumentType?
  bio_document_uploaded_at DateTime?

  // Opposite relation: one profile -> one ProfileVerification
  profileVerification ProfileVerification?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum BioDocumentType {
  PASSPORT
  GHANA_CARD
}

model UserVerification {
  id                String             @id @default(uuid())
  userId            String             @unique
  isVerified        Boolean            @default(false)
  verificationLevel VerificationLevel?
  //backgroundCheck    BackgroundCheck?
  // governmentId       GovernmentId?
  //selfieVerification SelfieVerification?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

