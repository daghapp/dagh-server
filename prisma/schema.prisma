generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                  @id @default(uuid())
  authProvider        AuthProvider
  email               String                  @unique
  passwordHash        String?
  passwordLastChanged DateTime?
  accountStatus       AccountStatus           @default(PENDING_VERIFICATION)
  accountType         AccountType             @default(USER)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @default(now())
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  fullName            String
  dateOfBirth         DateTime?
  gender              String?
  phoneNumber         String?                 @unique
  deviceTokens        DeviceToken[]
  payments            Payment[]
  profile             UserProfile?
  subscription        UserSubscription?
  verification        UserVerification?
  tourBookings        tour_bookings[]
  sentMessages        Message[]               @relation("SentMessages")
  receivedMessages    Message[]               @relation("ReceivedMessages")
  userTourItineraries user_tour_itineraries[]
  visaRequests       VisaOnArrivalRequest[]

  @@map("users")
}

model UserProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  username               String?
  firstName              String?
  lastName               String?
  dateOfBirth            DateTime?
  gender                 Gender?
  nationality            String?
  residenceCountry       String?
  residenceCity          String?
  residenceState         String?
  profilePhotoUrl        String?
  profilePhotoUploadedAt DateTime?
  bio                    String?
  languages              String[]
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserVerification {
  id                 String              @id @default(uuid())
  userId             String              @unique
  isVerified         Boolean             @default(false)
  verificationLevel  VerificationLevel?
  backgroundCheck    BackgroundCheck?
  governmentId       GovernmentId?
  selfieVerification SelfieVerification?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model GovernmentId {
  id             String           @id @default(uuid())
  verificationId String           @unique
  idType         String?
  number         String?          @unique
  country        String?
  expiryDate     DateTime?
  frontImageUrl  String?
  backImageUrl   String?
  uploadedAt     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("government_ids")
}

model SelfieVerification {
  id             String           @id @default(uuid())
  verificationId String           @unique
  imageUrl       String?
  matchScore     Int?
  verifiedAt     DateTime?
  aiProvider     String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("selfie_verifications")
}

model BackgroundCheck {
  id             String           @id @default(uuid())
  verificationId String           @unique
  status         String?
  provider       String?
  completedAt    DateTime?
  reportUrl      String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("background_checks")
}

model otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  purpose   String
}

model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String?
  platform  String?
  addedAt   DateTime? @default(now())
  expiredAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

