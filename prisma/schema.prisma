generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id @default(uuid())
  authProvider        AuthProvider
  email               String            @unique
  passwordHash        String?
  passwordLastChanged DateTime?
  accountStatus       AccountStatus     @default(PENDING_VERIFICATION)
  accountType         AccountType       @default(USER)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now())
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  fullName            String
  dateOfBirth         DateTime?
  gender              String?
  phoneNumber         String?           @unique
  deviceTokens        DeviceToken[]
  profile             UserProfile?
  verification        UserVerification?
  payments            Payment[]
  subscription        UserSubscription?

  @@map("users")
}

model UserProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  username               String?
  firstName              String?
  lastName               String?
  dateOfBirth            DateTime?
  gender                 Gender?
  nationality            String?
  residenceCountry       String?
  residenceCity          String?
  residenceState         String?
  profilePhotoUrl        String?
  profilePhotoUploadedAt DateTime?
  bio                    String?
  languages              String[]
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserVerification {
  id                 String              @id @default(uuid())
  userId             String              @unique
  isVerified         Boolean             @default(false)
  verificationLevel  VerificationLevel?
  backgroundCheck    BackgroundCheck?
  governmentId       GovernmentId?
  selfieVerification SelfieVerification?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model GovernmentId {
  id             String           @id @default(uuid())
  verificationId String           @unique
  idType         String?
  number         String?          @unique
  country        String?
  expiryDate     DateTime?
  frontImageUrl  String?
  backImageUrl   String?
  uploadedAt     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("government_ids")
}

model SelfieVerification {
  id             String           @id @default(uuid())
  verificationId String           @unique
  imageUrl       String?
  matchScore     Int?
  verifiedAt     DateTime?
  aiProvider     String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("selfie_verifications")
}

model BackgroundCheck {
  id             String           @id @default(uuid())
  verificationId String           @unique
  status         String?
  provider       String?
  completedAt    DateTime?
  reportUrl      String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("background_checks")
}

model otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  purpose   String
}

model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String?
  platform  String?
  addedAt   DateTime? @default(now())
  expiredAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  amount           Float
  description      String?
  status           PaymentStatus @default(PENDING)
  paymentReference String        @unique
  clientReference  String        @unique 
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model UserSubscription {
  id             String           @id @default(uuid())
  userId         String           @unique
  autoRenew      Boolean          @default(false)
  startDate      DateTime
  endDate        DateTime?
  status         SubscriptionStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingHistory BillingHistory[]

  @@map("user_subscriptions")
}

model BillingHistory {
  id               String           @id @default(uuid())
  subscriptionId   String
  amount           Float
  currency         String           @default("GHS")
  paymentReference String        @unique 
  status           PaymentStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_history")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum AccountType {
  USER
  ADMIN
  MODERATOR
}

enum AuthProvider {
  GOOGLE
  ICLOUD
  FACEBOOK
  EMAIL
  PASSWORD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VerificationLevel {
  BASIC
  ADVANCED
  FULL
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}
