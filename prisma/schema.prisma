generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id @default(uuid())
  authProvider        AuthProvider
  email               String            @unique
  passwordHash        String?
  passwordLastChanged DateTime?
  accountStatus       AccountStatus     @default(PENDING_VERIFICATION)
  accountType         AccountType       @default(USER)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now())
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  fullName            String
  dateOfBirth         DateTime?
  gender              String?
  phoneNumber         String?           @unique
  deviceTokens        DeviceToken[]
  payments            Payment[]
  profile             UserProfile?
  subscription        UserSubscription?
  verification        UserVerification?
  tourBookings        tour_bookings[]

  @@map("users")
}

model UserProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  username               String?
  firstName              String?
  lastName               String?
  dateOfBirth            DateTime?
  gender                 Gender?
  nationality            String?
  residenceCountry       String?
  residenceCity          String?
  residenceState         String?
  profilePhotoUrl        String?
  profilePhotoUploadedAt DateTime?
  bio                    String?
  languages              String[]
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserVerification {
  id                 String              @id @default(uuid())
  userId             String              @unique
  isVerified         Boolean             @default(false)
  verificationLevel  VerificationLevel?
  backgroundCheck    BackgroundCheck?
  governmentId       GovernmentId?
  selfieVerification SelfieVerification?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model GovernmentId {
  id             String           @id @default(uuid())
  verificationId String           @unique
  idType         String?
  number         String?          @unique
  country        String?
  expiryDate     DateTime?
  frontImageUrl  String?
  backImageUrl   String?
  uploadedAt     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("government_ids")
}

model SelfieVerification {
  id             String           @id @default(uuid())
  verificationId String           @unique
  imageUrl       String?
  matchScore     Int?
  verifiedAt     DateTime?
  aiProvider     String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("selfie_verifications")
}

model BackgroundCheck {
  id             String           @id @default(uuid())
  verificationId String           @unique
  status         String?
  provider       String?
  completedAt    DateTime?
  reportUrl      String?
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("background_checks")
}

model otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  purpose   String
}

model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String?
  platform  String?
  addedAt   DateTime? @default(now())
  expiredAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Payment {
  id               String         @id @default(uuid())
  userId           String
  amount           Float
  description      String?
  status           PaymentStatus  @default(PENDING)
  paymentReference String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clientReference  String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourBooking      tour_bookings?

  @@map("payments")
}

model UserSubscription {
  id             String             @id @default(uuid())
  userId         String             @unique
  autoRenew      Boolean            @default(false)
  startDate      DateTime
  endDate        DateTime?
  status         SubscriptionStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  billingHistory BillingHistory[]
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model BillingHistory {
  id               String           @id @default(uuid())
  subscriptionId   String
  amount           Float
  currency         String           @default("GHS")
  paymentReference String           @unique
  status           PaymentStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_history")
}

model itinerary_activities {
  id               String           @id
  itineraryId      String
  activityTime     String?
  activity         String?
  durationMinutes  Int?
  included         Boolean?
  cost             Decimal?
  locationName     String?
  locationAddress  String?
  tour_itineraries tour_itineraries @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model pricing_excludes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model pricing_includes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_itineraries {
  id                   String                 @id @default(uuid())
  tourId               String
  dayNumber            Int?
  title                String?                @db.VarChar(255)
  description          String?
  breakfast            Boolean?
  lunch                Boolean?
  dinner               Boolean?
  accommodationName    String?
  accommodationType    String?
  accommodationRating  Decimal?
  itinerary_activities itinerary_activities[]
  tour_packages        tour_packages          @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_locations {
  id            String        @id
  tourId        String
  name          String?
  city          String?
  region        String?
  description   String?
  visitDuration Int?
  photos        String[]
  tour_packages tour_packages @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_media {
  id            String        @id
  tour_id       String
  media_type    String?       @db.VarChar(20)
  url           String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_packages {
  id                 String             @id @default(uuid())
  title              String?
  slug               String?            @unique
  description        String?
  shortDescription   String?
  category           String?
  subcategory        String?
  durationDays       Int?
  durationNights     Int?
  basePrice          Decimal?
  currency           String?
  status             String?
  featured           Boolean            @default(false)
  trending           Boolean            @default(false)
  cancellationPolicy String?
  bookingDeadline    Int?
  minimumBooking     Int?
  accessibility      String?
  coverImage         String?
  heritageDnaTesting Boolean            @default(false)
  overallRating      Decimal?
  ratingCount        Int                @default(0)
  viewCount          Int                @default(0)
  bookingCount       Int                @default(0)
  wishlistCount      Int                @default(0)
  shareCount         Int                @default(0)
  conversionRate     Decimal?
  createdBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?
  publishedAt        DateTime?          @default(now())
  bookings           tour_bookings[]
  pricing_excludes   pricing_excludes[]
  pricing_includes   pricing_includes[]
  tour_itineraries   tour_itineraries[]
  tour_locations     tour_locations[]
  tour_media         tour_media[]
}

model tour_bookings {
  id                 String        @id @default(uuid())
  userId             String
  tourId             String
  bookingReference   String        @unique
  numberOfPeople     Int
  bookingDate        DateTime      @default(now())
  tourStartDate      DateTime
  tourEndDate        DateTime?
  totalPrice         Decimal
  currency           String        @default("GHS")
  status             BookingStatus @default(PENDING)
  paymentId          String?       @unique
  paymentStatus      PaymentStatus @default(PENDING)
  specialRequests    String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  emergencyContact   String?
  emergencyPhone     String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  refundAmount       Decimal?
  refundedAt         DateTime?
  confirmedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  payment            Payment?      @relation(fields: [paymentId], references: [id])
  tour               tour_packages @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([bookingDate])
  @@map("tour_bookings")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum AccountType {
  USER
  ADMIN
  MODERATOR
}

enum AuthProvider {
  GOOGLE
  ICLOUD
  FACEBOOK
  EMAIL
  PASSWORD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VerificationLevel {
  BASIC
  ADVANCED
  FULL
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
  NO_SHOW
}
