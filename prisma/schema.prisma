model UserSubscription {
  id             String             @id @default(uuid())
  userId         String             @unique
  autoRenew      Boolean            @default(false)
  startDate      DateTime
  endDate        DateTime?
  status         SubscriptionStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  billingHistory BillingHistory[]
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model BillingHistory {
  id               String           @id @default(uuid())
  subscriptionId   String
  amount           Float
  currency         String           @default("GHS")
  paymentReference String           @unique
  status           PaymentStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_history")
}

model itinerary_activities {
  id               String           @id
  itineraryId      String
  activityTime     String?
  activity         String?
  durationMinutes  Int?
  included         Boolean?
  cost             Decimal?
  locationName     String?
  locationAddress  String?
  tour_itineraries tour_itineraries @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model pricing_excludes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model pricing_includes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_itineraries {
  id                   String                 @id @default(uuid())
  tourId               String
  dayNumber            Int?
  title                String?                @db.VarChar(255)
  description          String?
  breakfast            Boolean?
  lunch                Boolean?
  dinner               Boolean?
  accommodationName    String?
  accommodationType    String?
  accommodationRating  Decimal?
  itinerary_activities itinerary_activities[]
  tour_packages        tour_packages          @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_locations {
  id            String        @id
  tourId        String
  name          String?
  city          String?
  region        String?
  description   String?
  visitDuration Int?
  photos        String[]
  tour_packages tour_packages @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_media {
  id            String        @id
  tour_id       String
  media_type    String?       @db.VarChar(20)
  url           String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_packages {
  id                 String             @id @default(uuid())
  title              String?
  slug               String?            @unique
  description        String?
  shortDescription   String?
  category           String?
  subcategory        String?
  durationDays       Int?
  durationNights     Int?
  basePrice          Decimal?
  currency           String?
  status             String?
  featured           Boolean            @default(false)
  trending           Boolean            @default(false)
  cancellationPolicy String?
  bookingDeadline    Int?
  minimumBooking     Int?
  accessibility      String?
  coverImage         String?
  heritageDnaTesting Boolean            @default(false)
  overallRating      Decimal?
  ratingCount        Int                @default(0)
  viewCount          Int                @default(0)
  bookingCount       Int                @default(0)
  wishlistCount      Int                @default(0)
  shareCount         Int                @default(0)
  conversionRate     Decimal?
  createdBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?
  publishedAt        DateTime?          @default(now())
  bookings           tour_bookings[]
  pricing_excludes   pricing_excludes[]
  pricing_includes   pricing_includes[]
  tour_itineraries   tour_itineraries[]
  tour_locations     tour_locations[]
  tour_media         tour_media[]
}

model tour_bookings {
  id                  String                  @id @default(uuid())
  userId              String
  tourId              String?
  bookingReference    String                  @unique
  numberOfPeople      Int
  bookingDate         DateTime                @default(now())
  tourStartDate       DateTime
  tourEndDate         DateTime?
  totalPrice          Decimal
  currency            String                  @default("GHS")
  status              BookingStatus           @default(PENDING)
  paymentId           String?                 @unique
  paymentStatus       PaymentStatus           @default(PENDING)
  specialRequests     String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  emergencyContact    String?
  emergencyPhone      String?
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledBy         String?
  refundAmount        Decimal?
  refundedAt          DateTime?
  confirmedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  tour                tour_packages?           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTourItineraries user_tour_itineraries[]
  systemGenerated     Boolean @default(false)


  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([bookingDate])
  @@map("tour_bookings")
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Conversation {
  id            String    @id @default(uuid())
  participants  String[]
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  @@map("conversations")
}

model user_tour_itineraries {
  id                  String                             @id @default(uuid())
  userId              String
  bookingId           String
  dayNumber           Int?
  title               String?                            @db.VarChar(255)
  description         String?
  breakfast           Boolean?
  lunch               Boolean?
  dinner              Boolean?
  accommodationName   String?
  accommodationType   String?
  accommodationRating Decimal?
  activities          user_tour_itineraries_activities[]
  user                User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking             tour_bookings                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("user_tour_itineraries")
}

model user_tour_itineraries_activities {
  id              String                @id @default(uuid())
  userItineraryId String
  activityTime    String?
  activity        String?
  durationMinutes Int?
  included        Boolean?
  cost            Decimal?
  locationName    String?
  locationAddress String?
  userItinerary   user_tour_itineraries @relation(fields: [userItineraryId], references: [id], onDelete: Cascade)

  @@map("user_tour_itineraries_activities")
}



model VisaOnArrivalRequest {
  id             String        @id @default(uuid())
  userId         String
  status         VisaRequestStatus @default(PENDING) // pending, approved, rejected
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  approval       VisaApproval?
  paymentId        String? // from the polymorphic payment table.
  visaData       VisaOnArrivalData?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("visa_on_arrival_requests")
}

model VisaOnArrivalData {
  id                      String    @id @default(uuid())
  requestId               String   @unique
  passport                String
  surname                 String
  first_name              String
  previous_name           String?
  date_of_birth           String
  place_of_birth          String
  nationality             String
  former_nationality      String?
  passport_number         String
  date_of_issue           String
  place_of_issue          String
  date_of_expiration      String
  email                   String
  whatsapp_number         String?
  date_of_arrival         DateTime?
  date_of_departure       DateTime?
  duration_of_stay        Int?
  purpose_of_trip         String
  primary_place_of_stay   String
  proof_of_accommodation  String
  request                 VisaOnArrivalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
 
  @@map("visa_on_arrival_data")
}


model VisaApproval {
  id          String               @id @default(uuid())
  requestId   String               @unique
  approvedBy  String?
  approvedAt  DateTime?
  status      VisaApprovalStatus   @default(PENDING) // pending, approved, rejected
  notes       String?
  request     VisaOnArrivalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("visa_on_arrival_approvals")
}


model Payment {
  id                String           @id @default(uuid())
  reference         String           @unique
  userId            String           @unique

  targetType        PaymentTargetType // the module access this
  targetId          String // the module's id

  amount            Float
  currency          String           @default("GHS")

  status            PaymentStatus    @default(PENDING)
  method            PaymentMethod?
  provider          PaymentProvider?

  providerReference String?
  transactionId     String?

  paidAt            DateTime?

  metadata          Json?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")

}


enum PaymentTargetType {
  VISA_ON_ARRIVAL
  TOUR_BOOKING
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum AccountType {
  USER
  ADMIN
  MODERATOR
}

enum AuthProvider {
  GOOGLE
  ICLOUD
  FACEBOOK
  EMAIL
  PASSWORD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VerificationLevel {
  BASIC
  ADVANCED
  FULL
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
  NO_SHOW
}

enum VisaRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VisaApprovalStatus {
  PENDING
  APPROVED
  REJECTED
} 

enum PaymentMethod {
  MTN_MOMO
  TELECEL_MOMO
  AT_MOMO
  CARD
  BANK_TRANSFER
  CASH
}

enum PaymentProvider {
  HUBTEL
  PAYSTACK
  STRIPE
  FLUTTERWAVE
}
