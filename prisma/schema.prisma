model Payment {
  id        String @id @default(uuid())
  reference String @unique
  userId    String

  description String?

  targetType PaymentTargetType // the module access this
  targetId   String // the module's id

  amount   Float
  currency String @default("GHS")

  status   PaymentStatus    @default(PENDING)
  method   PaymentMethod?
  provider PaymentProvider?

  // Partial/full refunds (§3.8). refundedAmount is cumulative; status flips to
  // PARTIALLY_REFUNDED then REFUNDED once refundedAmount >= amount.
  refundedAmount Float     @default(0)
  refundReason   String?
  refundedAt     DateTime?

  providerReference String?
  transactionId     String?

  paidAt DateTime?

  ledgerEntries LedgerTransaction[]

  metadata Json?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
