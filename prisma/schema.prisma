// Phase 3.1 — All available membership tier codes from Free to Elite Ambassador
enum MembershipTierCode {
  FREE
  BASELINE
  SENIOR_PIONEER
  SANKOFA_SETTLED
  BASIC
  SILVER
  GOLD_INVESTOR
  ELITE_AMBASSADOR
  FAMILY_PLAN
}

// Phase 3.1 — Billing intervals for membership plans
enum BillingInterval {
  MONTHLY
  ANNUAL
  BIENNIAL
  CUSTOM
}

// Phase 3.1 — Statuses for priority support tickets from paid-tier members
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Provider {
  provider_id         String   @id @default(uuid())
  verification_status Boolean  @default(false)
  display_name        String
  media_assets        String[] // Array of URLs
  location_lat        Float
  location_lng        Float
  location_address    String
  avg_rating          Float    @default(0)
  review_count        Int      @default(0)
  response_time_secs  Int      @default(3600)
  bio_description     String   @db.Text

  // Polymorphic relationship (one of these will be populated)
  tour_guide TourGuide?
  car_rental CarRental?
  hotel      Hotel?

  audit_logs       AuditLog[]
  service_requests ServiceRequest[]
}

model TourGuide {
  provider_id         String   @id
  language_capability String[] // ["English", "Twi", "French"]
  expertise_tags      String[] // ["Historical", "Nature"]
  charge_per_day      Float
  certification_docs  String[] // URLs to PDFs
  provider            Provider @relation(fields: [provider_id], references: [provider_id], onDelete: Cascade)
}

model CarRental {
  provider_id      String   @id
  vehicle_make     String
  vehicle_model    String
  vehicle_year     Int
  transmission     String
  fuel_type        String
  safety_features  String[]
  rental_terms_url String
  daily_rate       Float
  driver_required  Boolean

  transport_type TransportType?

  provider Provider @relation(fields: [provider_id], references: [provider_id])
}

model Hotel {
  provider_id String @id

  apartment_type ApartmentType?

  base_price_per_night Float
  provider             Provider @relation(fields: [provider_id], references: [provider_id], onDelete: Cascade)
}

// ============================================
// SERVICE REQUEST MODEL (For PII sanitization)
// ============================================

model ServiceRequest {
  request_token  String    @id @default(uuid())
  provider_id    String
  user_id        String // This is the CUSTOMER's ID
  status         String    @default("pending") // pending, confirmed, cancelled, completed
  requested_date DateTime
  confirmed_at   DateTime?
  created_at     DateTime  @default(now())

  provider Provider @relation(fields: [provider_id], references: [provider_id], onDelete: Cascade)
}

// ============================================
// AUDIT LOG MODEL (For the diary/audit trail)
// ============================================

model AuditLog {
  log_id      String   @id @default(uuid())
  user_id     String // Who did the action? (customer or provider)
  provider_id String // Which provider was involved?
  action      String // "viewed_profile", "requested_service", "confirmed", etc.
  metadata    Json // Extra details stored as JSON
  ip_address  String // Where did the request come from?
  timestamp   DateTime @default(now())

  provider Provider @relation(fields: [provider_id], references: [provider_id], onDelete: Cascade)
}

// Phase 3.1 — Defines each membership tier: pricing, billing interval, features, and popularity flag
// Seeded via src/seed.ts with 9 plans (Free through Elite Ambassador)
model MembershipPlan {
  id            String             @id @default(uuid())
  code          MembershipTierCode @unique // Maps to MembershipTierCode enum
  name          String                    // Display name shown on the plans UI
  description   String?
  price         Float                     // Price in the specified currency
  currency      String             @default("GHS")
  interval      BillingInterval           // How often the plan is billed
  features      String[]                  // Array of feature descriptions rendered as a bullet list
  isMostPopular Boolean            @default(false) // Highlighted as "Most Popular" on the frontend
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]

  @@map("membership_plans")
}

// Phase 3.1 — Priority support tickets raised by active paid-tier members
// Only users with a non-FREE, active subscription may create tickets
model PrioritySupportRequest {
  id             String              @id @default(uuid())
  subscriptionId String                    // FK to the user's subscription at time of creation
  userId         String
  subject        String
  message        String
  status         SupportTicketStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  subscription   UserSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("priority_support_requests")
}
