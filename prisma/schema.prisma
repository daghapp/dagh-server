generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  authProvider AuthProvider
  // Optional user preference used for itinerary personalization
  ethnicity    Ethnicity?

  email                   String                   @unique
  // Stable Sign in with Apple identifier (Apple's `sub`). Apple may withhold
  // the email or return a private-relay address, so this — not email — is the
  // account key for Apple logins.
  appleId                 String?                  @unique
  // Encrypted Apple refresh token, retained so account deletion can revoke it.
  appleRefreshToken       String?
  passwordHash            String?
  passwordLastChanged     DateTime?
  accountStatus           AccountStatus            @default(PENDING_VERIFICATION)
  accountType             AccountType              @default(USER)
  // Admin user lifecycle (§3.7): soft delete keeps the record for audit.
  isDeleted               Boolean                  @default(false)
  deletedAt               DateTime?
  // Reason for the latest status transition (suspend/reject/terminate/...).
  statusReason            String?
  statusChangedAt         DateTime?
  statusChangedBy         String?
  // Password-login lockout (§3.1): attempts reset on successful login.
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now())
  lastLoginAt             DateTime?
  lastActiveAt            DateTime?
  fullName                String
  // Login-profile fields (editable via PATCH /profile/account)
  username                String?                  @unique
  firstName               String?
  lastName                String?
  profileImageUrl         String?
  dateOfBirth             DateTime?
  gender                  String?
  phoneNumber             String?                  @unique
  phoneNumberHash         String?                  @unique
  phoneHash               String?
  deviceTokens            DeviceToken[]
  payments                Payment[]
  profile                 UserProfile?
  subscription            UserSubscription?
  // Phase 3.1 — Support tickets created by paid-tier members
  prioritySupportRequests PrioritySupportRequest[]
  supportTickets          SupportTicket[]
  verification            UserVerification?
  identityVerification    IdentityVerification?
  contentPosts            ContentPost[]
  contentAppeals          ContentAppeal[]
  forumThreads            ForumThread[]
  comments                Comment[]
  tourBookings            tour_bookings[]
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  userMatches             UserMatch[]              @relation("UserMatches")
  targetMatches           UserMatch[]              @relation("TargetMatches")
  blockedUsers            UserBlock[]              @relation("Blocker")
  blockedBy               UserBlock[]              @relation("Blocked")
  sentReports             UserReport[]             @relation("Reporter")
  receivedReports         UserReport[]             @relation("ReportedUser")
  outgoingCalls           Call[]                   @relation("OutgoingCalls")
  incomingCalls           Call[]                   @relation("IncomingCalls")
  devices                 UserDevice[]
  userTourItineraries     user_tour_itineraries[]
  visaRequests            VisaOnArrivalRequest[]

  tourRequests TourRequest[]

  // Community video interactions & unlocks
  videoInteractions VideoInteraction[]
  videoUnlocks      VideoUnlock[]
  channelAccess     ChannelAccess[]

  adminActivityLogs AdminActivityLog[]
  adminProfile      AdminProfile?

  // Admin-controlled complimentary access (comped/waived membership)
  accessGrants        SubscriptionAccessGrant[] @relation("AccessGrantSubject")
  accessGrantsIssued  SubscriptionAccessGrant[] @relation("AccessGrantIssuer")
  accessGrantsRevoked SubscriptionAccessGrant[] @relation("AccessGrantRevoker")

  datingProfile           DatingProfile?
  datingApplication       DatingApplication?
  userWarnings            UserWarning[]
  statusHistory           UserStatusHistory[]
  adminNotifications      AdminNotification[]         @relation("AdminNotifications")
  ngoMemberships          NgoMembership[]
  ngoAccessRequests       NgoAccessRequest[]
  swipesMade              UserSwipe[]                 @relation("Swiper")
  swipesReceived          UserSwipe[]                 @relation("SwipeTarget")
  discoveryPreference     DiscoveryPreference?
  notificationPreferences UserNotificationPreference?
  contactSyncConsent      ContactSyncConsent?
  contactMatches          ContactMatch[]                @relation("ContactMatchOwner")
  matchedByContacts       ContactMatch[]                @relation("ContactMatchMatched")
  phoneHashVariants       PhoneHashVariant[]
  proximityAlerts         DatingProximityNotification[] @relation("ProximityAlertRecipient")
  proximityAlertsAbout    DatingProximityNotification[] @relation("ProximityAlertNearby")

  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Public profile fields
  profileUrl  String?
  phoneNumber String?

  // Bio profile image
  bio_profile_image_url         String?
  bio_profile_image_uploaded_at DateTime?

  // Bio document uploads
  bio_document_urls        String[]
  bio_document_type        BioDocumentType?
  bio_document_number      String?          @unique
  bio_document_uploaded_at DateTime?

  // Opposite relation: one profile -> one ProfileVerification
  profileVerification ProfileVerification?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum BioDocumentType {
  PASSPORT
  GHANA_CARD
}

model UserVerification {
  id                String             @id @default(uuid())
  userId            String             @unique
  isVerified        Boolean            @default(false)
  verificationLevel VerificationLevel?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  purpose   String

  @@index([email, purpose])
}

model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String?
  platform  String?
  addedAt   DateTime? @default(now())
  expiredAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model UserDevice {
  id            String    @id @default(uuid())
  userId        String
  deviceId      String
  platform      Platform
  expoPushToken String?
  fcmToken      String?
  apnsToken     String?
  voipPushToken String?
  // End-to-end encryption: device public key (X25519) for key agreement.
  publicKey     String?
  keyVersion    Int       @default(0)
  keyUpdatedAt  DateTime?
  enabled       Boolean   @default(true)
  lastSeenAt    DateTime  @default(now())
  failureCount  Int       @default(0)
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([userId, enabled])
  @@map("user_devices")
}

model UserNotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  messagesEnabled      Boolean  @default(true)
  // Service/operational announcements are on by default; marketing/promotions
  // require an explicit in-app opt-in (Apple/Google/Expo policy).
  announcementsEnabled Boolean  @default(true)
  promotionsEnabled    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

// Phase 3.1 — Enhanced with planId, tierCode, and memberCode for the membership tiers system
model UserSubscription {
  id              String                   @id @default(uuid())
  userId          String                   @unique
  planId          String? // FK to the selected MembershipPlan (nullable for legacy records)
  tierCode        MembershipTierCode       @default(FREE) // Current tier level
  memberCode      String?                  @unique // Human-readable ID like "89345-SGF"
  autoRenew       Boolean                  @default(false)
  startDate       DateTime
  endDate         DateTime?
  status          SubscriptionStatus       @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  billingHistory  BillingHistory[]
  supportRequests PrioritySupportRequest[]
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            MembershipPlan?          @relation(fields: [planId], references: [id])

  @@map("user_subscriptions")
}

// Admin-controlled complimentary access. Lets an admin comp a specific user
// into a tier without a payment, without touching their UserSubscription row —
// so a grant and a real paid subscription coexist instead of overwriting each
// other, and revoking a comp cannot be mistaken for a cancellation.
//
// Grants are soft-revoked (revokedAt/revokedBy) and never deleted: the row is
// the audit record explaining why someone had access. For the same reason both
// actor FKs null out rather than restrict, so an admin can delete their own
// account without either losing the comps they issued or being blocked by them.
model SubscriptionAccessGrant {
  id               String             @id @default(uuid())
  userId           String
  tierCode         MembershipTierCode // Tier the grantee is comped into
  /// When true the comp also carries paid-tier perks (matching boost, priority
  /// support). When false the user is only spared the fee and stays functionally
  /// equivalent to FREE, so comped users never outrank paying members.
  includePaidPerks Boolean            @default(false)
  /// When true this comp also waives every service fee in the app (itinerary,
  /// tour bookings, etc.), not just the membership tier. Combined with a null
  /// endDate it represents a "lifetime free" account.
  waiveServiceFees Boolean            @default(false)
  reason           String // Why this comp exists, e.g. "Board member - 2026"
  startDate        DateTime           @default(now())
  /// null means perpetual. Grants never auto-renew; they run to endDate or forever.
  endDate          DateTime?
  /// null once the admin who issued the comp deletes their own account. The
  /// comp stays in force for the grantee — one admin closing their account must
  /// not silently revoke someone else's access — but the row no longer says who
  /// issued it. Matches revokedById below.
  grantedById      String?
  revokedAt        DateTime?
  revokedById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user            User                     @relation("AccessGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User?                    @relation("AccessGrantIssuer", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy       User?                    @relation("AccessGrantRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  supportRequests PrioritySupportRequest[]

  @@index([userId, revokedAt])
  @@index([tierCode])
  @@index([endDate])
  @@map("subscription_access_grants")
}

model BillingHistory {
  id               String           @id @default(uuid())
  subscriptionId   String
  amount           Float
  currency         String           @default("GHS")
  paymentReference String           @unique
  status           PaymentStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_history")
}

model itinerary_activities {
  id               String           @id
  itineraryId      String
  activityTime     String?
  activity         String?
  durationMinutes  Int?
  included         Boolean?
  cost             Decimal?
  locationName     String?
  locationAddress  String?
  tour_itineraries tour_itineraries @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model pricing_excludes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model pricing_includes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_itineraries {
  id                   String                 @id @default(uuid())
  tourId               String
  dayNumber            Int?
  title                String?                @db.VarChar(255)
  description          String?
  breakfast            Boolean?
  lunch                Boolean?
  dinner               Boolean?
  accommodationName    String?
  accommodationType    String?
  accommodationRating  Decimal?
  itinerary_activities itinerary_activities[]
  tour_packages        tour_packages          @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_locations {
  id            String        @id
  tourId        String
  name          String?
  city          String?
  region        String?
  description   String?
  visitDuration Int?
  photos        String[]
  latitude      Float?
  longitude     Float?
  tour_packages tour_packages @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_media {
  id            String        @id
  tour_id       String
  media_type    String?       @db.VarChar(20)
  url           String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_packages {
  id                 String             @id @default(uuid())
  title              String?
  slug               String?            @unique
  description        String?
  shortDescription   String?
  category           String?
  subcategory        String?
  durationDays       Int?
  durationNights     Int?
  basePrice          Decimal?
  currency           String?
  status             String?
  // Destination-catalogue fields (§3.5): primary region + human location label.
  region             String?
  location           String?
  lastModifiedBy     String?
  featured           Boolean            @default(false)
  trending           Boolean            @default(false)
  cancellationPolicy String?
  bookingDeadline    Int?
  minimumBooking     Int?
  accessibility      String?
  coverImage         String?
  heritageDnaTesting Boolean            @default(false)
  overallRating      Decimal?
  ratingCount        Int                @default(0)
  viewCount          Int                @default(0)
  bookingCount       Int                @default(0)
  wishlistCount      Int                @default(0)
  shareCount         Int                @default(0)
  conversionRate     Decimal?
  createdBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?
  publishedAt        DateTime?          @default(now())
  // Multi-tag categories for album structure (§5): e.g. ["Adventure", "Historical", "Wildlife"]
  categories         String[]           @default([])
  bookings           tour_bookings[]
  pricing_excludes   pricing_excludes[]
  pricing_includes   pricing_includes[]
  tour_itineraries   tour_itineraries[]
  tour_locations     tour_locations[]
  tour_media         tour_media[]
}

model tour_bookings {
  id                  String                  @id @default(uuid())
  userId              String
  tourId              String?
  bookingReference    String                  @unique
  numberOfPeople      Int
  bookingDate         DateTime                @default(now())
  tourStartDate       DateTime
  tourEndDate         DateTime?
  totalPrice          Decimal
  currency            String                  @default("GHS")
  status              BookingStatus           @default(PENDING)
  paymentId           String?                 @unique
  paymentStatus       PaymentStatus           @default(PENDING)
  // True when the fee was waived (payments disabled or price 0). Waived
  // bookings keep paymentId NULL so the unique column never collides.
  feeWaived           Boolean                 @default(false)
  specialRequests     String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  emergencyContact    String?
  emergencyPhone      String?
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledBy         String?
  refundAmount        Decimal?
  refundedAt          DateTime?
  confirmedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  tour                tour_packages?          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTourItineraries user_tour_itineraries[]
  systemGenerated     Boolean                 @default(false)

  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([bookingDate])
  @@map("tour_bookings")
}

model Message {
  id                String      @id @default(uuid())
  conversationId    String?
  senderId          String
  receiverId        String
  type              MessageType @default(TEXT)
  // Legacy plaintext content (null for end-to-end encrypted messages).
  content           String?
  // End-to-end encrypted payload (client-encrypted; server never holds keys).
  ciphertext        String?
  nonce             String?
  aad               String?
  encryptionVersion Int?
  mediaUrl          String?
  mediaDuration     Int?
  isRead            Boolean     @default(false)
  readAt            DateTime?
  createdAt         DateTime    @default(now())

  conversation   Conversation?         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User                  @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  pushDeliveries MessagePushDelivery[]

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Conversation {
  id            String    @id @default(uuid())
  participants  String[]
  lastMessage   String?
  lastMessageAt DateTime?
  messages      Message[]
  calls         Call[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@map("conversations")
}

model UserMatch {
  id        String      @id @default(uuid())
  userId    String
  matchedId String
  status    MatchStatus @default(MATCHED)
  createdAt DateTime    @default(now())

  user    User @relation("UserMatches", fields: [userId], references: [id], onDelete: Cascade)
  matched User @relation("TargetMatches", fields: [matchedId], references: [id], onDelete: Cascade)

  @@unique([userId, matchedId])
  @@map("user_matches")
}

// ─────────────────────────────────────────
// DATING MODULE — profile, swipes, discovery
// ─────────────────────────────────────────
model DatingProfile {
  id         String      @id @default(uuid())
  userId     String      @unique
  headline   String?
  about      String?     @db.Text
  photos     String[]
  heightCm   Int?
  interests  String[]
  lookingFor LookingFor?

  // --- Profile settings: Basic Info ---
  location String?

  // --- Profile settings: Education & Career ---
  degree       String?
  university   String?
  profession   String?
  industry     String?
  workLocation String?

  // --- Profile settings: Cultural Background ---
  languages String[]
  religion  String?
  hometown  String?

  // ── Tour-to-dating integration ─────────────────────────────────────────────
  // Where the user plans to travel / be available for casual dating, plus the
  // window during which their dating profile should surface for schedule overlap.
  travelLocationLat Float?
  travelLocationLng Float?
  availableFrom     DateTime?
  availableTo       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveryPreference DiscoveryPreference?
  tourSelections      TourRequestDatingSelection[]

  @@map("dating_profiles")
}

// ─────────────────────────────────────────
// JUNCTION — dating profiles the user selects to merge into a tour itinerary
// as social / leisure blocks after reviewing recommendations.
// ─────────────────────────────────────────
model TourRequestDatingSelection {
  id              String   @id @default(uuid())
  tourRequestId   String
  datingProfileId String
  createdAt       DateTime @default(now())

  tourRequest   TourRequest   @relation(fields: [tourRequestId], references: [id], onDelete: Cascade)
  datingProfile DatingProfile @relation(fields: [datingProfileId], references: [id], onDelete: Cascade)

  @@unique([tourRequestId, datingProfileId])
  @@index([tourRequestId])
  @@map("tour_request_dating_selections")
}

enum LookingFor {
  LONG_TERM_PARTNER
  SHORT_TERM
  FRIENDSHIP
  NOT_SURE
}

enum SwipeDirection {
  LIKE
  SUPER_LIKE
  PASS
}

model UserSwipe {
  id        String         @id @default(uuid())
  swiperId  String
  targetId  String
  direction SwipeDirection
  createdAt DateTime       @default(now())

  swiper User @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target User @relation("SwipeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([targetId])
  @@map("user_swipes")
}

model DiscoveryPreference {
  id               String      @id @default(uuid())
  userId           String      @unique
  lookingFor       LookingFor?
  genderPreference Gender[]
  minAge           Int         @default(18)
  maxAge           Int         @default(60)
  maxDistanceKm    Int         @default(50)
  globalDiscovery  Boolean     @default(true)
  locationLat      Float?
  locationLng      Float?
  locationName     String?
  // When the location above was last refreshed. Proximity alerts only consider
  // recently-refreshed locations so users are not notified about stale places.
  locationUpdatedAt DateTime?
  showProfile      Boolean     @default(true)
  showOnlineStatus Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  datingProfile   DatingProfile @relation(fields: [datingProfileId], references: [id], onDelete: Cascade)
  datingProfileId String        @unique

  @@map("discovery_preferences")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

// ─────────────────────────────────────────
// CONTACT DISCOVERY — privacy-preserving contact matching across the platform.
// Only SHA-256 phone hashes are stored; raw contact data never reaches the DB.
// ─────────────────────────────────────────
/// Every plausible SHA-256 phone form for a user (local, E.164, country-code).
/// Lets contacts that arrive as pre-computed hashes match regardless of the
/// phone format the client hashed.
model PhoneHashVariant {
  id     String @id @default(uuid())
  userId String
  hash   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hash, userId])
  @@index([hash])
  @@map("phone_hash_variants")
}

model ContactSyncConsent {
  id           String    @id @default(uuid())
  userId       String    @unique
  granted      Boolean   @default(true)
  grantedAt    DateTime?
  revokedAt    DateTime?
  lastSyncedAt DateTime?
  contactCount Int       @default(0)
  lookupHashes String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contact_sync_consents")
}

model ContactMatch {
  id            String   @id @default(uuid())
  userId        String
  matchedUserId String
  phoneHash     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User @relation("ContactMatchOwner", fields: [userId], references: [id], onDelete: Cascade)
  matchedUser User @relation("ContactMatchMatched", fields: [matchedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, matchedUserId])
  @@index([matchedUserId])
  @@map("contact_matches")
}

// ─────────────────────────────────────────
// DATING PROXIMITY — deduplication/cooldown for "someone nearby" alerts.
// One row per (recipient, nearby user) pair, refreshed when a new alert is sent.
// ─────────────────────────────────────────
model DatingProximityNotification {
  id           String   @id @default(uuid())
  userId       String
  nearbyUserId String
  distanceKm   Float
  notifiedAt   DateTime @default(now())

  user       User @relation("ProximityAlertRecipient", fields: [userId], references: [id], onDelete: Cascade)
  nearbyUser User @relation("ProximityAlertNearby", fields: [nearbyUserId], references: [id], onDelete: Cascade)

  @@unique([userId, nearbyUserId])
  @@index([userId, notifiedAt])
  @@map("dating_proximity_notifications")
}

model DatingActivityLog {
  id             String   @id @default(uuid())
  actorId        String
  entityType     String   // e.g. "BLOCK", "REPORT", "SWIPE"
  entityId       String
  action         String   // e.e. "BLOCK", "REPORT", "SWIPE_RECORDED"
  note           String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("dating_activity_logs")
}

model UserReport {
  id             String       @id @default(uuid())
  reporterId     String
  targetId       String
  reason         String
  details        String?
  status         ReportStatus @default(PENDING)
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("ReportedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetId])
  @@map("user_reports")
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Call {
  id             String     @id @default(uuid())
  roomId         String     @unique
  callerId       String
  receiverId     String
  conversationId String?
  callType       CallType
  status         CallStatus @default(INITIATING)
  createdAt      DateTime   @default(now())
  ringingAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  expiresAt      DateTime
  endedBy        String?
  failureReason  String?
  version        Int        @default(1)
  durationSec    Int?

  caller         User               @relation("OutgoingCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver       User               @relation("IncomingCalls", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  auditLogs      CallAuditLog[]
  pushDeliveries CallPushDelivery[]

  @@index([receiverId, status])
  @@index([callerId, status])
  @@index([conversationId, createdAt])
  @@index([status, expiresAt])
  @@map("calls")
}

