generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  authProvider AuthProvider
  // Optional user preference used for itinerary personalization
  ethnicity    Ethnicity?

  email               String                  @unique
  passwordHash        String?
  passwordLastChanged DateTime?
  accountStatus       AccountStatus           @default(PENDING_VERIFICATION)
  accountType         AccountType             @default(USER)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @default(now())
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  fullName            String
  dateOfBirth         DateTime?
  gender              String?
  phoneNumber         String?                 @unique
  deviceTokens        DeviceToken[]
  payments            Payment[]
  profile             UserProfile?
  subscription            UserSubscription?
  // Phase 3.1 — Support tickets created by paid-tier members
  prioritySupportRequests PrioritySupportRequest[]
  verification            UserVerification?
  tourBookings          tour_bookings[]
  sentMessages        Message[]               @relation("SentMessages")
  receivedMessages    Message[]               @relation("ReceivedMessages")
  userMatches         UserMatch[]             @relation("UserMatches")
  targetMatches       UserMatch[]             @relation("TargetMatches")
  blockedUsers        UserBlock[]             @relation("Blocker")
  blockedBy           UserBlock[]             @relation("Blocked")
  sentReports         UserReport[]            @relation("Reporter")
  receivedReports     UserReport[]            @relation("ReportedUser")
  outgoingCalls       CallLog[]               @relation("OutgoingCalls")
  incomingCalls       CallLog[]               @relation("IncomingCalls")
  userTourItineraries user_tour_itineraries[]
  visaRequests        VisaOnArrivalRequest[]

  tourRequests TourRequest[]

  adminActivityLogs AdminActivityLog[]

  datingProfile         DatingProfile?
  swipesMade            UserSwipe[]   @relation("Swiper")
  swipesReceived        UserSwipe[]   @relation("SwipeTarget")
  discoveryPreference   DiscoveryPreference?

  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Public profile fields
  profileUrl  String?
  phoneNumber String?

  // Bio profile image
  bio_profile_image_url         String?
  bio_profile_image_uploaded_at DateTime?

  // Bio document uploads
  bio_document_urls        String[]
  bio_document_type        BioDocumentType?
  bio_document_uploaded_at DateTime?

  // Opposite relation: one profile -> one ProfileVerification
  profileVerification ProfileVerification?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum BioDocumentType {
  PASSPORT
  GHANA_CARD
}

model UserVerification {
  id                String             @id @default(uuid())
  userId            String             @unique
  isVerified        Boolean            @default(false)
  verificationLevel VerificationLevel?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  purpose   String

  @@index([email, purpose])
}

model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String?
  platform  String?
  addedAt   DateTime? @default(now())
  expiredAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Phase 3.1 — Enhanced with planId, tierCode, and memberCode for the membership tiers system
model UserSubscription {
  id              String                 @id @default(uuid())
  userId          String                 @unique
  planId          String?                // FK to the selected MembershipPlan (nullable for legacy records)
  tierCode        MembershipTierCode     @default(FREE) // Current tier level
  memberCode      String?                @unique         // Human-readable ID like "89345-SGF"
  autoRenew       Boolean                @default(false)
  startDate       DateTime
  endDate         DateTime?
  status          SubscriptionStatus     @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  billingHistory  BillingHistory[]
  supportRequests PrioritySupportRequest[]
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            MembershipPlan?        @relation(fields: [planId], references: [id])

  @@map("user_subscriptions")
}

model BillingHistory {
  id               String           @id @default(uuid())
  subscriptionId   String
  amount           Float
  currency         String           @default("GHS")
  paymentReference String           @unique
  status           PaymentStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_history")
}

model itinerary_activities {
  id               String           @id
  itineraryId      String
  activityTime     String?
  activity         String?
  durationMinutes  Int?
  included         Boolean?
  cost             Decimal?
  locationName     String?
  locationAddress  String?
  tour_itineraries tour_itineraries @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model pricing_excludes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model pricing_includes {
  id            String        @id
  tour_id       String
  item          String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_itineraries {
  id                   String                 @id @default(uuid())
  tourId               String
  dayNumber            Int?
  title                String?                @db.VarChar(255)
  description          String?
  breakfast            Boolean?
  lunch                Boolean?
  dinner               Boolean?
  accommodationName    String?
  accommodationType    String?
  accommodationRating  Decimal?
  itinerary_activities itinerary_activities[]
  tour_packages        tour_packages          @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_locations {
  id            String        @id
  tourId        String
  name          String?
  city          String?
  region        String?
  description   String?
  visitDuration Int?
  photos        String[]
  tour_packages tour_packages @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model tour_media {
  id            String        @id
  tour_id       String
  media_type    String?       @db.VarChar(20)
  url           String?
  tour_packages tour_packages @relation(fields: [tour_id], references: [id], onDelete: Cascade)
}

model tour_packages {
  id                 String             @id @default(uuid())
  title              String?
  slug               String?            @unique
  description        String?
  shortDescription   String?
  category           String?
  subcategory        String?
  durationDays       Int?
  durationNights     Int?
  basePrice          Decimal?
  currency           String?
  status             String?
  featured           Boolean            @default(false)
  trending           Boolean            @default(false)
  cancellationPolicy String?
  bookingDeadline    Int?
  minimumBooking     Int?
  accessibility      String?
  coverImage         String?
  heritageDnaTesting Boolean            @default(false)
  overallRating      Decimal?
  ratingCount        Int                @default(0)
  viewCount          Int                @default(0)
  bookingCount       Int                @default(0)
  wishlistCount      Int                @default(0)
  shareCount         Int                @default(0)
  conversionRate     Decimal?
  createdBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?
  publishedAt        DateTime?          @default(now())
  bookings           tour_bookings[]
  pricing_excludes   pricing_excludes[]
  pricing_includes   pricing_includes[]
  tour_itineraries   tour_itineraries[]
  tour_locations     tour_locations[]
  tour_media         tour_media[]
}

model tour_bookings {
  id                  String                  @id @default(uuid())
  userId              String
  tourId              String?
  bookingReference    String                  @unique
  numberOfPeople      Int
  bookingDate         DateTime                @default(now())
  tourStartDate       DateTime
  tourEndDate         DateTime?
  totalPrice          Decimal
  currency            String                  @default("GHS")
  status              BookingStatus           @default(PENDING)
  paymentId           String?                 @unique
  paymentStatus       PaymentStatus           @default(PENDING)
  specialRequests     String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  emergencyContact    String?
  emergencyPhone      String?
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledBy         String?
  refundAmount        Decimal?
  refundedAt          DateTime?
  confirmedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  tour                tour_packages?          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTourItineraries user_tour_itineraries[]
  systemGenerated     Boolean                 @default(false)

  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([bookingDate])
  @@map("tour_bookings")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String?
  senderId       String
  receiverId     String
  type           MessageType  @default(TEXT)
  content        String?
  mediaUrl       String?
  mediaDuration  Int?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Conversation {
  id            String    @id @default(uuid())
  participants  String[]
  lastMessage   String?
  lastMessageAt DateTime?
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@map("conversations")
}

model UserMatch {
  id        String      @id @default(uuid())
  userId    String
  matchedId String
  status    MatchStatus @default(MATCHED)
  createdAt DateTime    @default(now())

  user    User @relation("UserMatches", fields: [userId], references: [id], onDelete: Cascade)
  matched User @relation("TargetMatches", fields: [matchedId], references: [id], onDelete: Cascade)

  @@unique([userId, matchedId])
  @@map("user_matches")
}

// ─────────────────────────────────────────
// DATING MODULE — profile, swipes, discovery
// ─────────────────────────────────────────
model DatingProfile {
  id                 String                @id @default(uuid())
  userId             String                @unique
  headline           String?
  about              String?               @db.Text
  photos             String[]
  heightCm           Int?
  interests          String[]
  lookingFor         LookingFor?

  // --- Profile settings: Basic Info ---
  location           String?

  // --- Profile settings: Education & Career ---
  degree             String?
  university         String?
  profession         String?
  industry           String?
  workLocation       String?

  // --- Profile settings: Cultural Background ---
  languages          String[]
  religion           String?
  hometown           String?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveryPreference DiscoveryPreference?

  @@map("dating_profiles")
}

enum LookingFor {
  LONG_TERM_PARTNER
  SHORT_TERM
  FRIENDSHIP
  NOT_SURE
}

enum SwipeDirection {
  LIKE
  SUPER_LIKE
  PASS
}

model UserSwipe {
  id        String         @id @default(uuid())
  swiperId  String
  targetId  String
  direction SwipeDirection
  createdAt DateTime       @default(now())

  swiper User @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target User @relation("SwipeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([targetId])
  @@map("user_swipes")
}

model DiscoveryPreference {
  id               String  @id @default(uuid())
  userId           String  @unique
  lookingFor       LookingFor?
  genderPreference Gender[]
  minAge           Int     @default(18)
  maxAge           Int     @default(60)
  maxDistanceKm    Int     @default(50)
  locationLat      Float?
  locationLng      Float?
  locationName     String?
  showProfile      Boolean @default(true)
  showOnlineStatus Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  datingProfile DatingProfile  @relation(fields: [datingProfileId], references: [id], onDelete: Cascade)
  datingProfileId String       @unique

  @@map("discovery_preferences")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model UserReport {
  id             String        @id @default(uuid())
  reporterId     String
  targetId       String
  reason         String
  details        String?
  status         ReportStatus  @default(PENDING)
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("ReportedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetId])
  @@map("user_reports")
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model CallLog {
  id          String     @id @default(uuid())
  callerId    String
  receiverId  String
  callType    CallType
  status      CallStatus @default(MISSED)
  roomId      String
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  durationSec Int?       @default(0)

  caller   User @relation("OutgoingCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("IncomingCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@map("call_logs")
}

enum MessageType {
  TEXT
  VOICE_NOTE
  IMAGE
  VIDEO
  CALL_LOG
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  MISSED
  COMPLETED
  DECLINED
  BUSY
  CANCELLED
}

enum MatchStatus {
  PENDING
  MATCHED
  UNMATCHED
}

model user_tour_itineraries {
  id                  String                             @id @default(uuid())
  userId              String
  bookingId           String
  dayNumber           Int?
  title               String?                            @db.VarChar(255)
  description         String?
  breakfast           Boolean?
  lunch               Boolean?
  dinner              Boolean?
  accommodationName   String?
  accommodationType   String?
  accommodationRating Decimal?
  activities          user_tour_itineraries_activities[]
  user                User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking             tour_bookings                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("user_tour_itineraries")
}

model user_tour_itineraries_activities {
  id              String                @id @default(uuid())
  userItineraryId String
  activityTime    String?
  activity        String?
  durationMinutes Int?
  included        Boolean?
  cost            Decimal?
  locationName    String?
  locationAddress String?
  userItinerary   user_tour_itineraries @relation(fields: [userItineraryId], references: [id], onDelete: Cascade)

  @@map("user_tour_itineraries_activities")
}

model VisaOnArrivalRequest {
  id          String             @id @default(uuid())
  userId      String
  status      VisaRequestStatus  @default(PENDING) // pending, approved, rejected
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  approval    VisaApproval?
  paymentId   String?            @unique // from the polymorphic payment table.
  visaData    VisaOnArrivalData?
  packageType VisaPackageType?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("visa_on_arrival_requests")
}

model VisaOnArrivalData {
  id                       String               @id @default(uuid())
  requestId                String               @unique
  passport_image_url       String
  bio_page_image_url       String
  flight_itinerary_image_url String
  passport_number          String
  purpose_of_trip          String
  date_of_departure        DateTime
  date_of_arrival          DateTime
  request                  VisaOnArrivalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("visa_on_arrival_data")
}

model VisaApproval {
  id         String               @id @default(uuid())
  requestId  String               @unique
  approvedBy String?
  approvedAt DateTime?
  status     VisaApprovalStatus   @default(PENDING) // pending, approved, rejected
  notes      String?
  request    VisaOnArrivalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("visa_on_arrival_approvals")
}

model Payment {
  id        String @id @default(uuid())
  reference String @unique
  userId    String

  description String?

  targetType PaymentTargetType // the module access this
  targetId   String // the module's id

  amount   Float
  currency String @default("GHS")

  status   PaymentStatus    @default(PENDING)
  method   PaymentMethod?
  provider PaymentProvider?

  providerReference String?
  transactionId     String?

  paidAt DateTime?

  ledgerEntries LedgerTransaction[]

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("payments")
}

model HubtelDirectReceiveLog {
  id                    String  @id @default(uuid())
  message               String?
  responseCode          String?
  amount                Float?
  charges               Float?
  amountAfterCharges    Float?
  amountCharged         Float?
  description           String?
  clientReference       String? // your merchant reference
  transactionId         String? // Hubtel transaction ID
  externalTransactionId String? // telco reference
  orderId               String?
  deliveryFee           Float?
  paymentDetails        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hubtel_direct_receive_logs")
}

model LedgerAccount {
  id           String              @id @default(uuid())
  name         String              @unique // e.g. "Account_DAGh_Revenue", "Account_GIS_Statutory_Reserve"
  currency     String // GHS or USD
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions LedgerTransaction[]
}

model LedgerTransaction {
  id          String        @id @default(uuid())
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String
  type        String // CREDIT or DEBIT
  description String?
  createdAt   DateTime      @default(now())
}

// ─────────────────────────────────────────
// ADMIN ACTIVITY LOG — audit trail for admin console actions
// (approve/reject/retry/status changes). Unlike the provider-scoped
// `AuditLog`, this is keyed to any domain entity via entityType + entityId.
// ─────────────────────────────────────────
model AdminActivityLog {
  id         String   @id @default(uuid())
  actorId    String
  entityType String // e.g. "VISA_REQUEST", "PAYMENT", "TOUR", "USER", "REPORT"
  entityId   String?
  action     String // e.g. "APPROVED", "REJECTED", "NOTE_ADDED", "STATUS_CHANGED"
  note       String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// ─────────────────────────────────────────
// STATIC LOOKUP TABLE — seeded with real Ghana locations
// ─────────────────────────────────────────
model TourSite {
  id          String       @id @default(uuid())
  name        String       @unique
  region      String
  latitude    Float
  longitude   Float
  description String
  imageUrl    String?
  category    SiteCategory
  createdAt   DateTime     @default(now())

  requestSites      TourRequestSite[]
  itineraryDaySites ItineraryDaySite[]

  @@map("tour_sites")
}

// ─────────────────────────────────────────
// TOUR REQUEST — submitted by user from frontend
// ─────────────────────────────────────────
enum Ethnicity {
  African
  Asian
  Black_African_American
  Caribbean
  Caucassian_White
  Hispanic_Latino
  Middle_Eastern
  Mixed
  Native_American_Indigenous
  Pacific_Islander
  Other
}

model TourRequest {
  id                 String   @id @default(uuid())
  userId             String
  tourType           TourType
  durationDays       Int // touring days only (excl. prep + departure)
  relocationInterest Boolean  @default(false) // saved, not acted on yet

  status RequestStatus @default(PENDING)

  apartmentType     ApartmentType?
  transportType     TransportType?
  companionInterest Boolean        @default(false)
  ethnicity         Ethnicity?

  paymentId     String?       @unique
  paymentStatus PaymentStatus @default(INITIALIZED)

  createdAt DateTime @default(now())

  selectedSites TourRequestSite[]
  itinerary     Itinerary?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentStatus])
  @@map("tour_requests")
}

// ─────────────────────────────────────────
// JUNCTION — which sites the user selected
// ─────────────────────────────────────────
model TourRequestSite {
  id            String @id @default(uuid())
  tourRequestId String
  tourSiteId    String

  tourRequest TourRequest @relation(fields: [tourRequestId], references: [id], onDelete: Cascade)
  tourSite    TourSite    @relation(fields: [tourSiteId], references: [id])

  @@unique([tourRequestId, tourSiteId])
  @@map("tour_request_sites")
}

// ─────────────────────────────────────────
// ITINERARY — generated after validation
// ─────────────────────────────────────────
model Itinerary {
  id               String   @id @default(uuid())
  tourRequestId    String   @unique
  isFeasible       Boolean
  feasibilityError String? // populated if validation fails
  totalDays        Int // durationDays + 2 (prep + departure)
  createdAt        DateTime @default(now())

  tourRequest TourRequest    @relation(fields: [tourRequestId], references: [id], onDelete: Cascade)
  days        ItineraryDay[]

  @@map("itineraries")
}

// ─────────────────────────────────────────
// ITINERARY DAY — one row per day of the trip
// ─────────────────────────────────────────
model ItineraryDay {
  id                 String  @id @default(uuid())
  itineraryId        String
  dayNumber          Int // 1-based
  dayType            DayType
  relocationRequired Boolean @default(false) // saved, not acted on yet
  suggestedHotel     String? // saved, not acted on yet

  itinerary Itinerary          @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  sites     ItineraryDaySite[]

  @@unique([itineraryId, dayNumber])
  @@map("itinerary_days")
}

// ─────────────────────────────────────────
// ITINERARY DAY SITES — sites assigned to each touring day
// ─────────────────────────────────────────
model ItineraryDaySite {
  id             String @id @default(uuid())
  itineraryDayId String
  tourSiteId     String
  visitOrder     Int // 1, 2, or 3 — order within the day

  itineraryDay ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  tourSite     TourSite     @relation(fields: [tourSiteId], references: [id])

  @@unique([itineraryDayId, visitOrder])
  @@unique([itineraryDayId, tourSiteId])
  @@map("itinerary_day_sites")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────
// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────
enum TourType {
  GROUP
  SINGLE
}

enum RequestStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum DayType {
  PREPARATION
  TOURING
  DEPARTURE
}

enum SiteCategory {
  NATURE
  CULTURAL
  HISTORICAL
  BEACH
  WILDLIFE
  RELIGIOUS
  SCENIC
}

// Phase 3.1 — Added MEMBERSHIP_SUBSCRIPTION for membership payment routing
enum PaymentTargetType {
  VISA_ON_ARRIVAL
  TOUR_BOOKING
  TOUR_REQUEST
  MEMBERSHIP_SUBSCRIPTION
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum AccountType {
  USER
  ADMIN
  MODERATOR
}

enum AuthProvider {
  GOOGLE
  ICLOUD
  FACEBOOK
  EMAIL
  PASSWORD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VerificationLevel {
  // 1) Phone number verification
  PHONE_NUMBER_VERIFICATION

  // 2) IP address check
  IP_ADDRESS_CHECK

  // 3) Bio/profile image check
  BIO_PROFILE_IMAGE_CHECK

  // 4) Document check
  DOCUMENT_CHECK
}

model ProfileVerification {
  id            String      @id @default(uuid())
  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  isVerified   Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  phone_number_verified    Boolean @default(false)
  ip_address_verification  Boolean @default(false)
  bio_profile_verification Boolean @default(false)
  document_verification    Boolean @default(false)

  // Which verification step should be shown/considered "current" for the user.
  // Example values: PHONE_NUMBER_VERIFICATION, PROFILE_IMAGE_VERIFICATION, DOCUMENT_VERIFICATION
  // (kept as String to avoid schema complexity for now)
  validationStep String? @default("PHONE_NUMBER_VERIFICATION")

  verification_message String?

  // Bio Data approval
  bioDataStatus          VerificationStatus @default(PENDING)
  bioDataApprovedBy      String?
  bioDataApprovedAt      DateTime?
  bioDataApprovalReason  String?
  bioDataRejectedBy      String?
  bioDataRejectedAt      DateTime?
  bioDataRejectionReason String?

  // Face Verification approval
  faceStatus          VerificationStatus @default(PENDING)
  faceApprovedBy      String?
  faceApprovedAt      DateTime?
  faceApprovalReason  String?
  faceRejectedBy      String?
  faceRejectedAt      DateTime?
  faceRejectionReason String?

  // Documents (Passport/Ghana Card) approval
  documentStatus          VerificationStatus @default(PENDING)
  documentApprovedBy      String?
  documentApprovedAt      DateTime?
  documentApprovalReason  String?
  documentRejectedBy      String?
  documentRejectedAt      DateTime?
  documentRejectionReason String?

  @@map("profile_verification")
}

