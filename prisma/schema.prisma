// ── Payment Gateway Settings ───────────────────────────────────────────────────
// One row per payment provider. The provider is part of the primary lookup
// (rather than hardcoding a single "gateway settings" row) so that adding a
// second provider later is a data change, not a migration of the shape.
//
// Credentials are stored only as AES-256-GCM ciphertext (see
// src/helpers/encryption.ts) and are never selected into any API response — the
// controller exposes `hasClientId` / `hasClientSecret` presence flags instead.
//
// `connectedEnvironment` records *which* environment the last successful
// verification covered. `connectionStatus` alone is not sufficient: an admin can
// flip TEST -> LIVE, leaving a stale `CONNECTED` that refers to the old
// environment. Processing may only be enabled when this field equals
// `environment`.
model PaymentGatewayConfig {
  id                       String                         @id @default(uuid())
  provider                 PaymentGatewayProvider         @unique
  clientIdEncrypted        String?                        @db.Text
  clientSecretEncrypted    String?                        @db.Text
  environment              PaymentGatewayEnvironment      @default(TEST)
  connectionStatus         PaymentGatewayConnectionStatus @default(NOT_CONNECTED)
  connectedEnvironment     PaymentGatewayEnvironment?
  lastTestedAt             DateTime?
  lastConnectedAt          DateTime?
  /// Coarse, non-secret failure classification for support triage
  /// (e.g. "invalid_credentials", "timeout"). Never a provider error body.
  lastErrorCategory        String?
  /// Master switch. Enforced on checkout (503 when false). Only ever settable to
  /// true when the current environment's connection is verified.
  paymentProcessingEnabled Boolean                        @default(false)
  /// Why processing was last turned off, surfaced by the legacy
  /// GET /admin/payments/status alias for backward compatibility.
  processingDisabledReason String?
  updatedBy                String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  @@map("payment_gateway_configs")
}

enum PaymentGatewayProvider {
  HUBTEL
}

enum PaymentGatewayEnvironment {
  TEST
  LIVE
}

enum PaymentGatewayConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

// ── Community Video Feed ──────────────────────────────────────────────────────
// CommunityVideo: admin-managed cards linking to YouTube content.
// Displayed in the app feed; full playback is gated behind a subscribe prompt.
//
// Gating contract: teaserUrl is a *clipped preview* only (a YouTube embed URL
// carrying start/end bounds). The full-length video URL is never stored — it is
// derived from youtubeVideoId at response time and only emitted for users who
// already hold a VideoUnlock, so a locked card cannot leak the full link.
model CommunityVideo {
  id                     String    @id @default(uuid())
  title                  String
  description            String
  teaserUrl              String // CLIPPED preview embed URL (or animated thumbnail)
  previewStartSeconds    Int       @default(0)
  previewDurationSeconds Int       @default(30)
  thumbnailUrl           String
  youtubeVideoId         String    @unique // used to build deep links on mobile
  isPublished            Boolean   @default(true)
  publishedAt            DateTime  @default(now())
  // YouTube's own public counters, refreshed by the channel sync. Denormalised
  // because there is nowhere else to read them from: VideoInteraction only sees
  // in-app activity (previews played, full videos opened, unlocks) and cannot
  // report what happened on the channel itself. The feed ranks on these
  // (sort=most_watched / most_liked), so they are stored rather than recomputed.
  viewCount              Int       @default(0)
  likeCount              Int       @default(0)
  // When the two counters above were last refreshed. Null on rows predating the
  // columns and on cards published by hand, so the app can tell "nobody has
  // watched this" apart from "we have never checked".
  statsSyncedAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  interactions VideoInteraction[]
  unlocks      VideoUnlock[]

  // Feed indexes: every feed read filters on isPublished and then orders by one
  // of these three, so each ordering gets its own composite index.
  @@index([isPublished, publishedAt])
  @@index([isPublished, viewCount])
  @@index([isPublished, likeCount])
  @@map("community_videos")
}

// VideoInteraction: append-only analytics event log.
// One row per user action; used to measure funnel conversion.
// durationMs is client-reported time (ms) the user spent on the event source
// (e.g. seconds into the 30s teaser before leaving) — null when not reported.
model VideoInteraction {
  id         String               @id @default(uuid())
  userId     String
  videoId    String
  action     VideoInteractionType
  durationMs Int?
  createdAt  DateTime             @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  video CommunityVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, videoId])
  @@index([videoId, action])
  @@map("video_interactions")
}

// VideoUnlock: persists per-user unlock state across sessions.
// Unique constraint ensures idempotency — calling unlock multiple times is safe.
model VideoUnlock {
  id         String   @id @default(uuid())
  userId     String
  videoId    String
  unlockedAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  video CommunityVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_unlocks")
}

/// ChannelAccess: the one channel-wide authorization decision for a user.
///
/// A YouTube subscription is granted per CHANNEL, not per video, so this is the
/// row that actually unlocks the feed. VideoUnlock (above) is retained because it
/// answers a per-video question — how many people opened *this* card, and what the
/// per-video conversion funnel looks like — which a channel grant cannot. It is
/// deliberately NOT an independent grant: revoking here deletes those rows, so a
/// stale card read has nothing left to reopen.
///
/// It was called a grant, and behaved like a boolean: written once on a positive
/// verdict, never re-checked, never expiring, and carrying no version. That is
/// enough to unlock a feed and not enough to survive an unsubscribe, because
/// YouTube publishes no unsubscribe event — the only way to learn about one is to
/// ask, on a schedule. So access here is a LEASE:
///
///   status + accessExpiresAt   a confirmed positive is honoured until its lease
///                              lapses, and lapsing is a hard stop that no
///                              failure can extend. Revocation latency is
///                              therefore bounded by the lease rather than by
///                              whether a poll happened to fire.
///   CHECK_FAILED               "we could not find out", kept distinct from
///                              NOT_SUBSCRIBED ("we checked; the answer was no").
///                              A Google outage must not lock out every subscriber.
///   accessVersion              monotonic, so two contradicting answers can be
///                              ordered. A slow response that lands after a
///                              revocation must not resurrect it on a client.
///
/// The Google identity behind the link is stored too. The subscription check can
/// only be made with the token of the Google account the user authorizes, so a
/// durable subject (not an email, which can be renamed) is what makes the same
/// email rule auditable and the credential renewable instead of one-shot.
enum ChannelAccessStatus {
  /// A confirmed positive. Access only while accessExpiresAt is in the future.
  SUBSCRIBED
  /// A completed check whose answer was no. No lease, and a revocation recorded.
  NOT_SUBSCRIBED
  /// No usable Google link yet, or none has been checked.
  NOT_CONNECTED
  /// A link exists but cannot answer the subscription question — revoked,
  /// missing the YouTube scope, or an unreadable credential.
  REAUTH_REQUIRED
  /// The check could not be completed. NOT evidence of an unsubscribe.
  CHECK_FAILED
}

model ChannelAccess {
  id                         String              @id @default(uuid())
  userId                     String
  channelId                  String
  unlockedAt                 DateTime            @default(now())
  /// What the last completed check concluded. Defaults to NOT_CONNECTED, which is
  /// what a row created without a verdict is: no check has been made, so no access
  /// is implied by existing here.
  status                     ChannelAccessStatus @default(NOT_CONNECTED)
  /// Last check that SUCCEEDED, positive or negative. Null means no check has
  /// ever completed on this row. Distinct from unlockedAt, which is the original
  /// conversion timestamp and is never rewritten by a later check.
  verifiedAt                 DateTime?
  /// Expiry of the current positive lease. The read that serves full-video
  /// fields requires one of these; its absence is what stops a grant nobody has
  /// re-checked from being honoured forever.
  accessExpiresAt            DateTime?
  /// Bumped on every committed verdict, including ones a client cannot observe a
  /// difference from. Ordering only — the count itself carries no meaning.
  accessVersion              Int                 @default(1)
  /// Stable Google subject identifier (`sub` from a verified id_token). The
  /// durable identity: an email address can be renamed, and the app's own email
  /// says nothing about which Google account holds the subscription.
  googleSubject              String?
  /// Verified Google email, kept for display and audit of the same-email rule.
  googleEmail                String?
  /// The YouTube identity the subscription check was actually made for, where
  /// Google reported one. Diagnostic: the check itself is answered by the
  /// access token's own account.
  authorizedYoutubeChannelId String?
  /// Space-separated scopes Google actually granted. Read on every check to
  /// catch a credential that cannot answer subscriptions.list before spending a
  /// token refresh and a quota unit discovering it cannot.
  grantedScopes              String?
  /// Google's long-lived credential, captured with access_type=offline and
  /// stored SEALED. This is the basis of the whole guarantee: it is what lets a
  /// subscription be re-checked long after the ~1h access token expired. A row
  /// without one cannot be re-checked at all, so it is REAUTH_REQUIRED rather
  /// than trusted — an unverifiable grant is a grant nobody can revoke.
  refreshToken               String?
  /// Set when access was closed. Non-null means the row is inert: every read
  /// path filters it out. Kept rather than deleted because it is the audit record
  /// of a subscription that was once held.
  revokedAt                  DateTime?
  revokedReason              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId, revokedAt])
  // Drives the active-user sweep: rows whose lease has lapsed are exactly the
  // ones whose access is no longer backed by a current verdict.
  @@index([status, accessExpiresAt])
  @@map("channel_access")
}

